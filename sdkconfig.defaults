# Target profile: physically identified ZX4D30CE40S-V13 / P4 rev v3.2.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# WT0132P4-A1 N16R32X: 32 MiB HEX PSRAM, per board vendor config.
# Real PSRAM size is logged and displayed at runtime; not yet measured on LaunchPad.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# V1.3 reference power domains: SPI flash at 3.3 V; HEX PSRAM at 1.8 V.
# Explicit before any experimental flash to avoid differing IDF defaults.
CONFIG_ESP_LDO_RESERVE_SPI_NOR_FLASH=y
CONFIG_ESP_LDO_CHAN_SPI_NOR_FLASH_DOMAIN=1
CONFIG_ESP_LDO_VOLTAGE_SPI_NOR_FLASH_3300_MV=y
CONFIG_ESP_LDO_RESERVE_PSRAM=y
CONFIG_ESP_LDO_CHAN_PSRAM_DOMAIN=2
CONFIG_ESP_LDO_VOLTAGE_PSRAM_1800_MV=y

# J10 is our only USB serial/JTAG debug interface; no UART adapter required.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL dashboard + CST3240 I2C input exhausted the default 4 KiB main task
# stack on hardware (reproducible stack protection fault, 2026-10-15).
# Keep this explicit and confirm runtime headroom before reducing it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL 9.4.0 from an exact version constraint in main/idf_component.yml.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# ZX4D30CE40S-V13 with ESP32-C5, not the C61 default in vendor sdkconfig.
# Host and factory co-processor must agree on ESP-Hosted 2.12.3 and checksum.
# C5 firmware on THIS unit has not been identified. Never auto-flash the C5.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c5"
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=31
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=32
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=33
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=34
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=30
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=29
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=28
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=28
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=31
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=32
CONFIG_ESP_HOSTED_SDIO_PIN_D0=33
CONFIG_ESP_HOSTED_SDIO_PIN_D1=34
CONFIG_ESP_HOSTED_SDIO_PIN_D2=30
CONFIG_ESP_HOSTED_SDIO_PIN_D3=29
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
CONFIG_ESP_HOSTED_SDIO_CHECKSUM=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# Build for size: C5/Hosted networking almost filled the original 1 MiB app.
# No partition table or bootloader flash is permitted in this change.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
