# Target profile: physically identified ZX4D30CE40S-V13 / P4 rev v3.2.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# WT0132P4-A1 N16R32X: 32 MiB HEX PSRAM, per board vendor config.
# Real PSRAM size is logged and displayed at runtime; not yet measured on LaunchPad.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# V1.3 reference power domains: SPI flash at 3.3 V; HEX PSRAM at 1.8 V.
# Explicit before any experimental flash to avoid differing IDF defaults.
CONFIG_ESP_LDO_RESERVE_SPI_NOR_FLASH=y
CONFIG_ESP_LDO_CHAN_SPI_NOR_FLASH_DOMAIN=1
CONFIG_ESP_LDO_VOLTAGE_SPI_NOR_FLASH_3300_MV=y
CONFIG_ESP_LDO_RESERVE_PSRAM=y
CONFIG_ESP_LDO_CHAN_PSRAM_DOMAIN=2
CONFIG_ESP_LDO_VOLTAGE_PSRAM_1800_MV=y

# J10 is our only USB serial/JTAG debug interface; no UART adapter required.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9.4.0 from an exact version constraint in main/idf_component.yml.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
